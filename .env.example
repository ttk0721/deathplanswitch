# Host port the web container is published on.
DPS_PORT=8080
# Time zone for logs and schedules.
TZ=Europe/Warsaw
# Optional Healthchecks.io ping URL; the scheduler pings it every tick (and /fail on trouble).
HEARTBEAT_URL=
# Image to run. Pin a version tag (for example ghcr.io/ttk0721/deathplanswitch:sha-abc1234) instead of latest.
# DPS_IMAGE=ghcr.io/ttk0721/deathplanswitch:latest
