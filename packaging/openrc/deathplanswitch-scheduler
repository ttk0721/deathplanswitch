#!/sbin/openrc-run
# Death Plan Switch (scheduler) for OpenRC. Settings: /etc/default/deathplanswitch

name="Death Plan Switch scheduler"
description="Death Plan Switch scheduler"

# The settings file is data, not shell: read KEY=value lines for the known keys
# only (root runs this, so nothing in the file is ever evaluated).
dps_load_env() {
	[ -r /etc/default/deathplanswitch ] || return 0
	while IFS='=' read -r k v || [ -n "$k" ]; do
		case "$k" in
			DPS_DATA | DPS_LISTEN | HEARTBEAT_URL | DPS_APPRISE_URL | PHP_CLI_SERVER_WORKERS | TZ) ;;
			*) continue ;;
		esac
		case "$v" in
			\"*\") v=${v#\"}; v=${v%\"} ;;
			\'*\') v=${v#\'}; v=${v%\'} ;;
		esac
		export "$k=$v"
	done < /etc/default/deathplanswitch
}
dps_load_env
: "${DPS_DATA:=/var/lib/deathplanswitch}"
export DPS_DATA DPS_LISTEN HEARTBEAT_URL DPS_APPRISE_URL PHP_CLI_SERVER_WORKERS

supervisor=supervise-daemon
respawn_delay=5
command=/usr/bin/php
command_args="/usr/share/deathplanswitch/bin/scheduler.php"
command_user=deathplanswitch:deathplanswitch
directory=/usr/share/deathplanswitch
output_log=/var/log/deathplanswitch-scheduler.log
error_log=/var/log/deathplanswitch-scheduler.log

depend() {
	need net
	after deathplanswitch-web
}

# Same rules as the web script: refuse anything but plain values.
dps_validate() {
	case "$DPS_DATA" in
		/*) ;;
		*) eerror "DPS_DATA must be an absolute path"; return 1 ;;
	esac
	case "$DPS_DATA" in
		*[!A-Za-z0-9._/@+-]*) eerror "DPS_DATA has characters that are not allowed"; return 1 ;;
	esac
	for u in "${HEARTBEAT_URL:-}" "${DPS_APPRISE_URL:-}"; do
		[ -z "$u" ] && continue
		case "$u" in
			http://* | https://*) ;;
			*) eerror "URL settings must start with http:// or https://"; return 1 ;;
		esac
		case "$u" in
			*[!]A-Za-z0-9._~:/?#@%\&=+,[-]*) eerror "a URL setting has characters that are not allowed"; return 1 ;;
		esac
	done
	return 0
}

start_pre() {
	dps_validate || return 1
	checkpath --directory --mode 0700 --owner deathplanswitch:deathplanswitch "$DPS_DATA"
	checkpath --file --mode 0640 --owner deathplanswitch:deathplanswitch /var/log/deathplanswitch-scheduler.log
}
